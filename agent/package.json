{
  "name": "orbit-agent",
  "version": "1.1.0",
  "private": true,
  "description": "Orbit agent - keeps this PC reachable from the Orbit website.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "rescan": "node src/index.js --rescan",
    "show": "node src/index.js --show",
    "build": "node ../scripts/build-exe.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "bin": "src/index.js",
  "pkg": {
    "assets": [
      "scripts/**/*.ps1",
      "src/build.json",
      "package.json"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  }
}
